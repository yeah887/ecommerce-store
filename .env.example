# Copy to .env and adjust. Docker Compose reads .env automatically; it is git-ignored.

# MongoDB connection used by the API
MONGO_URL=mongodb://mongo:27017/store

# Production-like mode (docker compose -f compose.yaml up --build): the store is served here
WEB_PORT=8080

# Dev mode (docker compose up): Angular dev server, API and MongoDB are exposed on these host ports
WEB_DEV_PORT=4200
API_PORT=3000
MONGO_PORT=27017

# Signs session cookies. Required in production-like mode: at least 32 random characters, e.g.
#   openssl rand -base64 48
# Dev mode falls back to an insecure built-in secret when this is empty.
SESSION_SECRET=change-me-to-a-long-random-string

# Only send the session cookie over HTTPS. Keep false for the local stack, which serves plain HTTP.
COOKIE_SECURE=false

# First admin account, created on startup if no user with this email exists yet.
# Changing the password here later does not change an existing account.
# Dev mode defaults to admin@example.com / admin-password when these are empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
